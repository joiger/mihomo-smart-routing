{
  "subscriptions": [
    {
      "name": "Provider_1",
      "url": "https://example.com/sub/your_token_here",
      "headers": {
        "User-Agent": "Clash-verge/1.7.7",
        "x-hwid": "your_custom_hwid_if_needed",
        "x-device-os": "Windows",
        "x-ver-os": "11",
        "x-device-model": "PC"
      },
      "use_cookies": false
    },
    {
      "name": "Provider_2",
      "url": "https://example.com/another_sub_token",
      "headers": {
        "User-Agent": "Hiddify/2.0.5",
        "x-hwid": "your_custom_hwid_if_needed"
      },
      "use_cookies": false
    },
    {
      "name": "Provider_3",
      "url": "https://example.com/cookie_protected_sub",
      "headers": {
        "User-Agent": "Hiddify/2.0.5"
      },
      "use_cookies": true
    }
  ],
  "options": {
    "mixed_port": 7890,
    "socks_port": 7891,
    "redir_port": 7892,
    "allow_lan": true,
    "mode": "rule",
    "log_level": "info",
    "output_files": [
      "./Aegis.yaml",
      "~/Downloads/Aegis.yaml"
    ],
    "categories": [
      {
        "name": "🎯 Games",
        "default_options": ["DIRECT", "Auto-Fallback", "Auto-UrlTest"],
        "rules": [
          "GEOSITE,steam",
          "GEOSITE,epicgames",
          "GEOSITE,riot",
          "DOMAIN-SUFFIX,steampowered.com",
          "DOMAIN-SUFFIX,epicgames.com"
        ]
      },
      {
        "name": "✈️ Telegram",
        "default_options": ["Auto-Fallback", "Auto-UrlTest", "DIRECT"],
        "rules": [
          "GEOSITE,telegram",
          "DOMAIN-SUFFIX,t.me",
          "DOMAIN-SUFFIX,telegram.org",
          "GEOIP,telegram"
        ]
      },
      {
        "name": "💬 Discord",
        "default_options": ["Auto-Fallback", "Auto-UrlTest", "DIRECT"],
        "rules": [
          "GEOSITE,discord",
          "DOMAIN-SUFFIX,discord.com",
          "DOMAIN-SUFFIX,discord.gg"
        ]
      },
      {
        "name": "🎬 Media-Streaming",
        "default_options": ["Auto-Fallback", "Auto-UrlTest", "DIRECT"],
        "rules": [
          "DOMAIN-SUFFIX,youtube.com",
          "DOMAIN-SUFFIX,googlevideo.com",
          "DOMAIN-SUFFIX,soundcloud.com"
        ]
      },
      {
        "name": "🤖 AI-Services",
        "priority": "ai",
        "default_options": ["Auto-Fallback", "Auto-UrlTest", "DIRECT"],
        "rules": [
          "DOMAIN-SUFFIX,openai.com",
          "DOMAIN-SUFFIX,chatgpt.com",
          "DOMAIN-SUFFIX,anthropic.com",
          "DOMAIN-SUFFIX,claude.ai",
          "DOMAIN-SUFFIX,gemini.google.com",
          "GEOSITE,openai",
          "GEOSITE,anthropic",
          "GEOSITE,google-gemini"
        ]
      }
    ]
  }
}
