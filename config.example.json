{
  "subscriptions": [
    {
      "name": "Provider_1",
      "url": "https://example.com/sub/your_token_here",
      "headers": {
        "User-Agent": "Clash-verge/1.7.7",
        "x-hwid": "your_custom_hwid_if_needed",
        "x-device-os": "Windows",
        "x-ver-os": "11",
        "x-device-model": "PC"
      },
      "use_cookies": false
    },
    {
      "name": "Provider_2",
      "url": "https://example.com/another_sub_token",
      "headers": {
        "User-Agent": "Hiddify/2.0.5",
        "x-hwid": "your_custom_hwid_if_needed"
      },
      "use_cookies": false
    },
    {
      "name": "Provider_3",
      "url": "https://example.com/cookie_protected_sub",
      "headers": {
        "User-Agent": "Hiddify/2.0.5"
      },
      "use_cookies": true
    }
  ],
  "options": {
    "routing": {
      "primary_pool_size": 5,
      "node_order": [],
      "primary_nodes": [],
      "mobile_nodes": [],
      "ai_nodes": [],
      "ai_max_trust_nodes": []
    },
    "mixed_port": 7890,
    "socks_port": 7891,
    "redir_port": 7892,
    "allow_lan": true,
    "mode": "rule",
    "log_level": "info",
    "output_files": [
      "./Aegis.yaml",
      "~/Downloads/Aegis.yaml"
    ],
    "categories": [
      {
        "name": "🤖 AI-Services",
        "auto_group": "🤖 Auto-AI-Stable",
        "reserve_group": "Aegis-AI-Reserve",
        "priority": "ai",
        "health_check_url": "https://generativelanguage.googleapis.com",
        "expected_status": "404",
        "default_options": ["🤖 AI-Max-Trust", "🤖 Auto-AI-Stable", "Auto-Fallback", "🛡️ Mobile-Bypass", "REJECT"],
        "rules": [
          "DOMAIN-SUFFIX,openai.com",
          "DOMAIN-SUFFIX,chatgpt.com",
          "DOMAIN-SUFFIX,anthropic.com",
          "DOMAIN-SUFFIX,claude.ai",
          "DOMAIN-SUFFIX,gemini.google.com",
          "DOMAIN-SUFFIX,generativelanguage.googleapis.com",
          "DOMAIN-SUFFIX,aistudio.google.com",
          "GEOSITE,openai",
          "GEOSITE,anthropic",
          "GEOSITE,google-gemini"
        ]
      },
      {
        "name": "🎬 YouTube",
        "type": "url-test",
        "priority": "media",
        "health_check_url": "https://www.youtube.com/generate_204",
        "rules": [
          "GEOSITE,youtube",
          "DOMAIN-SUFFIX,youtube.com",
          "DOMAIN-SUFFIX,googlevideo.com",
          "DOMAIN-SUFFIX,ytimg.com",
          "DOMAIN-SUFFIX,youtu.be"
        ]
      },
      {
        "name": "🎵 SoundCloud",
        "type": "url-test",
        "priority": "media",
        "health_check_url": "https://soundcloud.com",
        "rules": [
          "DOMAIN-SUFFIX,soundcloud.com",
          "DOMAIN-SUFFIX,sndcdn.com"
        ]
      },
      {
        "name": "📱 TikTok",
        "type": "url-test",
        "priority": "fallback",
        "health_check_url": "https://www.tiktok.com",
        "rules": [
          "GEOSITE,tiktok",
          "DOMAIN-SUFFIX,tiktok.com",
          "DOMAIN-SUFFIX,byteoversea.com",
          "DOMAIN-SUFFIX,ibytedtos.com"
        ]
      },
      {
        "name": "✈️ Telegram",
        "type": "fallback",
        "priority": "telegram",
        "health_check_url": "http://cp.cloudflare.com/generate_204",
        "rules": [
          "GEOSITE,telegram",
          "DOMAIN-SUFFIX,t.me",
          "DOMAIN-SUFFIX,telegram.org",
          "GEOIP,telegram"
        ]
      },
      {
        "name": "💻 GitHub",
        "type": "url-test",
        "priority": "dev",
        "health_check_url": "https://github.com",
        "rules": [
          "GEOSITE,github",
          "DOMAIN-SUFFIX,github.com",
          "DOMAIN-SUFFIX,githubusercontent.com",
          "DOMAIN,gist.githubusercontent.com"
        ]
      },
      {
        "name": "🏠 Smart Home",
        "type": "select",
        "default_options": ["🛡️ Mobile-Bypass", "Auto-Fallback", "DIRECT"],
        "rules": [
          "DOMAIN-SUFFIX,ui.nabu.casa",
          "DOMAIN-SUFFIX,nabucasa.com",
          "DOMAIN-SUFFIX,home-assistant.io"
        ]
      },
      {
        "name": "🧹 Xiaomi Vacuum",
        "type": "select",
        "default_options": ["Auto-Fallback", "🛡️ Mobile-Bypass", "DIRECT"],
        "device_ips": [
          "192.168.1.150"
        ],
        "rules": [
          "PROCESS-NAME,com.xiaomi.smarthome",
          "PROCESS-NAME,com.xiaomi.home",
          "PROCESS-NAME,com.roborock.smart",
          "PROCESS-NAME,com.dreame.smart",
          "DOMAIN-SUFFIX,miui.com",
          "DOMAIN-SUFFIX,xiaomi.com",
          "DOMAIN-SUFFIX,mi.com",
          "DOMAIN-SUFFIX,xiaomi.net",
          "DOMAIN-SUFFIX,mi-img.com",
          "DOMAIN-SUFFIX,io.mi.com",
          "DOMAIN-SUFFIX,ot.io.mi.com",
          "DOMAIN-SUFFIX,ott.io.mi.com",
          "DOMAIN-SUFFIX,api.io.mi.com",
          "DOMAIN-SUFFIX,spec.idservice.io.mi.com",
          "DOMAIN-SUFFIX,sec.mi.com",
          "DOMAIN-SUFFIX,mhs-service.mi.com",
          "DOMAIN-SUFFIX,mi-idc.com",
          "DOMAIN-SUFFIX,gslb.mi-idc.com",
          "DOMAIN-SUFFIX,dreame.tech",
          "DOMAIN-SUFFIX,dreame.com",
          "DOMAIN-SUFFIX,roborock.com",
          "DOMAIN-SUFFIX,roidmi.com",
          "DOMAIN-SUFFIX,viomi.com.cn",
          "DOMAIN-SUFFIX,viomi.com",
          "DOMAIN-SUFFIX,mijia.tech",
          "DOMAIN-KEYWORD,xiaomi",
          "DOMAIN-KEYWORD,miui",
          "DOMAIN-KEYWORD,miio",
          "GEOSITE,xiaomi"
        ]
      },
      {
        "name": "🏦 Banks",
        "type": "select",
        "default_options": ["DIRECT", "Auto-Fallback", "🛡️ Mobile-Bypass"],
        "rules": [
          "DOMAIN-SUFFIX,tbank.ru",
          "DOMAIN-SUFFIX,tinkoff.ru",
          "DOMAIN-SUFFIX,ozon.ru",
          "DOMAIN-SUFFIX,finance.ozon.ru"
        ]
      }
    ]
  }
}
